@page "/clientes/crear"
@rendermode InteractiveServer
@inject ClienteService ClienteService
@inject NavigationManager Nav
@using Facturador.Contracts.Clientes
@using Microsoft.AspNetCore.Components.Forms

<h3>Crear Cliente</h3>

<EditForm Model="@nuevoCliente" OnValidSubmit="GuardarCliente" FormName="CrearClienteForm" Enhance="false">

    <DataAnnotationsValidator />
    <div class="mb-3">
        <label class="form-label">Razón Social</label>
        <InputText class="form-control" name="RazonSocial" @bind-Value="nuevoCliente.RazonSocial" />
    </div>

    <div class="mb-3">
        <label class="form-label">CUIT</label>
        <InputText class="form-control" @bind-Value="nuevoCliente.CUIT" />
    </div>

    <div class="mb-3">
        <label class="form-label">Dirección</label>
        <InputText class="form-control" @bind-Value="nuevoCliente.Direccion" />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a class="btn btn-secondary" href="/clientes">Volver</a>

</EditForm>

@code {

    ClienteCreateDto nuevoCliente = new();
    EditContext editContext;

    protected override void OnInitialized()
    {
        editContext = new EditContext(nuevoCliente);
    }

    private async Task GuardarCliente()
    {
        await ClienteService.CrearClienteAsync(nuevoCliente);
        Nav.NavigateTo("/clientes");
    }
}
